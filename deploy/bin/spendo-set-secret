#!/bin/bash
# Stores a secret for the Spendo sync, encrypted with systemd-creds (host key).
# Only units that declare LoadCredentialEncrypted=spendo-<name> can read it.
#
# Usage: sudo spendo-set-secret <santander-rut|santander-password|mercadopago-token>
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo "Ejecuta con sudo" >&2; exit 1; }

name="${1:-}"
case "$name" in
    santander-rut|santander-password|mercadopago-token) ;;
    *) echo "Uso: sudo spendo-set-secret <santander-rut|santander-password|mercadopago-token>" >&2; exit 1 ;;
esac

read -rsp "Valor para $name: " value; echo
[[ -n "$value" ]] || { echo "Valor vacío" >&2; exit 1; }

install -d -m 700 /etc/credstore.encrypted
printf "%s" "$value" | systemd-creds encrypt --name="spendo-$name" - "/etc/credstore.encrypted/spendo-$name"
chmod 600 "/etc/credstore.encrypted/spendo-$name"
unset value

echo "Guardado: /etc/credstore.encrypted/spendo-$name"
